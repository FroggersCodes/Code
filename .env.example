# Upstash Redis — required for leaderboard/data to persist across deployments
# Free tier available at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# LemonSqueezy Configuration
# Get these from https://app.lemonsqueezy.com/settings
LEMONSQUEEZY_API_KEY=your_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Variant IDs — create products in LemonSqueezy dashboard, then copy variant IDs
LEMONSQUEEZY_VARIANT_AVATAR_PACK=your_avatar_pack_variant_id
LEMONSQUEEZY_VARIANT_TITLE_PACK=your_title_pack_variant_id
LEMONSQUEEZY_VARIANT_BUNDLE=your_bundle_variant_id

# Your app's public URL (used for checkout redirect and Socket.IO CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.IO server URL — leave blank in production (same host), set for separate deployments
NEXT_PUBLIC_SOCKET_URL=

# Admin panel passphrase — set a strong secret value
NEXT_PUBLIC_ADMIN_PASSPHRASE=your_admin_passphrase_here
ADMIN_PASSPHRASE=your_admin_passphrase_here
