# LemonSqueezy Configuration
# Get these from https://app.lemonsqueezy.com/settings
LEMONSQUEEZY_API_KEY=your_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Variant IDs — create products in LemonSqueezy dashboard, then copy variant IDs
LEMONSQUEEZY_VARIANT_AVATAR_PACK=your_avatar_pack_variant_id
LEMONSQUEEZY_VARIANT_TITLE_PACK=your_title_pack_variant_id
LEMONSQUEEZY_VARIANT_BUNDLE=your_bundle_variant_id

# Your app's public URL (used for checkout redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000
